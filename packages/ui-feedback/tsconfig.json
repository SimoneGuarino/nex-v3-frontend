{
  "compilerOptions": {
    "target": "ES2020", "module": "ESNext", "moduleResolution": "Node", "jsx": "react-jsx",
    "declaration": true, "outDir": "dist", "strict": true, "esModuleInterop": true, "skipLibCheck": true
  },
    "include": [
        "src/**/*.ts",
        "src/**/*.tsx"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ]
}